# Salin ke deploy/.env di server (ter-gitignore). Pakai password alfanumerik (tanpa $ atau ").

FE_DOMAIN=koleksi.club
API_DOMAIN=api.koleksi.club

DB_DATABASE=koleksi
DB_USERNAME=koleksi
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Token statis FE -> BE. Dipakai sebagai BACKEND_API_TOKEN (fe) & FRONTEND_API_TOKEN (be).
# Generate: openssl rand -hex 32
BACKEND_API_TOKEN=

# Kosongkan kalau upload disimpan di disk VPS ({API_DOMAIN}/storage). Isi URL publik bucket kalau pakai S3/R2.
BACKEND_STORAGE_URL=

# Port internal (hanya 127.0.0.1) yang dituju reverse proxy Apache Webuzo. Samakan dengan deploy/webuzo/*.conf.
FE_PORT=3000
APP_PORT=8080

# --- Hanya untuk VPS tanpa panel (port 80/443 bebas): HTTPS lewat Caddy ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml
# ACME_EMAIL=admin@koleksi.club
