# Salin ke deploy/.env di server (ter-gitignore).

FE_DOMAIN=koleksi.club
API_DOMAIN=api.koleksi.club

# Database: MariaDB bawaan Webuzo di host (buat database & user lewat panel Webuzo).
# Webuzo memberi prefix nama user panel, mis. koleksi_web.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Token statis FE -> BE. Dipakai sebagai BACKEND_API_TOKEN (fe) & FRONTEND_API_TOKEN (be).
# Sama dengan secret BACKEND_API_TOKEN di repo GitHub koleksi-fe (dipakai saat build image).
# Generate: openssl rand -hex 32
BACKEND_API_TOKEN=

# Kosongkan kalau upload disimpan di disk VPS ({API_DOMAIN}/storage). Isi URL publik bucket kalau pakai S3/R2.
BACKEND_STORAGE_URL=

# Port internal (hanya 127.0.0.1) yang dituju reverse proxy Apache Webuzo. Samakan dengan deploy/webuzo/*.conf.
FE_PORT=3000
APP_PORT=8080

# Tag image di ghcr.io (latest = build terakhir dari branch main; atau isi SHA commit untuk rollback)
IMAGE_TAG=latest

# Batas thread (VPS OpenVZ). Naikkan hanya kalau batas thread VPS memungkinkan.
PHP_THREADS=4
APP_PIDS_LIMIT=96
FE_PIDS_LIMIT=64

# --- Hanya untuk VPS tanpa panel (port 80/443 bebas): HTTPS lewat Caddy ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml
# CMS_DOMAIN=cms.koleksi.club
# ACME_EMAIL=admin@koleksi.club
